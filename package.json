{
  "name": "problem-definition-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first structured problem definition studio with deterministic prompt exports.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project problem-definition-workbench-test \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@mikejhill/portable-document-browser": "0.1.0",
    "@mikejhill/portable-document-codec": "0.1.0",
    "@mikejhill/portable-document-core": "0.1.0",
    "@mikejhill/portable-document-firebase": "0.1.0",
    "@mikejhill/portable-document-indexeddb": "0.1.0",
    "@mikejhill/portable-document-react": "0.1.0",
    "@mikejhill/portable-document-sync": "0.1.0",
    "firebase": "12.17.0",
    "lucide-react": "1.28.0",
    "lz-string": "1.5.0",
    "mermaid": "11.16.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@mikejhill/portable-document-testing": "0.1.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "fake-indexeddb": "6.2.5",
    "firebase-tools": "15.30.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
