{
  "name": "problem-definition-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first structured problem definition studio with deterministic prompt exports.",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:rules": "firebase emulators:exec --only firestore --project problem-definition-workbench-test \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@mikejhill/portable-document-browser": "0.1.0",
    "@mikejhill/portable-document-codec": "0.1.0",
    "@mikejhill/portable-document-core": "0.1.0",
    "@mikejhill/portable-document-firebase": "0.1.0",
    "@mikejhill/portable-document-indexeddb": "0.1.0",
    "@mikejhill/portable-document-react": "0.1.0",
    "@mikejhill/portable-document-sync": "0.1.0",
    "firebase": "12.19.0",
    "lucide-react": "1.28.0",
    "lz-string": "1.5.0",
    "mermaid": "11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@firebase/rules-unit-testing": "5.0.1",
    "@mikejhill/portable-document-testing": "0.1.0",
    "@playwright/test": "1.65.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.6",
    "firebase-tools": "15.36.0",
    "jsdom": "27.4.0",
    "prettier": "3.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "re2js": "^2.10.0",
    "katex": "^0.18.11",
    "glob": "^14.0.5",
    "uuid": "^11.1.1",
    "@google-cloud/pubsub": {
      "@opentelemetry/core": "^2.8.0"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
